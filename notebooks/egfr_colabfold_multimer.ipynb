    "# ─── COLABFOLD API METHOD ─────────────────────────────────────────────────────\n",
    "# Uses ColabFold server for MSA generation + AF2 multimer prediction\n",
    "# Format: binder_sequence:target_sequence\n",
    "\n",
    "def submit_to_colabfold_server(binder_seq: str, target_seq: str, name: str) -> Dict:\n",
    "    \"\"\"\n",
    "    Submit a complex prediction to ColabFold server.\n",
    "    \n",
    "    INPUT FORMAT: chain_A:chain_B (colon-separated)\n",
    "    chain_A = binder sequence\n",
    "    chain_B = EGFR Domain III target\n",
    "    \n",
    "    NOTE: For automated Kaggle use, we use the ColabFold server API.\n",
    "    Alternatively, run this manually at https://colabfold.com\n",
    "    \"\"\"\n",
    "    multimer_input = f'{binder_seq}:{target_seq}'\n",
    "    \n",
    "    # ColabFold server submission\n",
    "    # API endpoint (may require registration for high-throughput)\n",
    "    url = 'https://api.colabfold.com/ticket/msa'\n",
    "    \n",
    "    payload = {\n",
    "        'q': multimer_input,\n",
    "        'mode': 'paired-unpaired',  # Paired + unpaired MSA for multimer\n",
    "    }\n",
    "    \n",
    "    return {'binder': binder_seq, 'target': target_seq, 'name': name, 'input': multimer_input}\n",
    "\n",
    "\n",
    "def parse_alphafold_metrics(result_dir: str) -> Dict:\n",
    "    \"\"\"\n",
    "    Parse AlphaFold2 Multimer output metrics.\n",
    "    Reads from result JSON files generated by ColabFold.\n",
    "    \n",
    "    Key metrics:\n",
    "    - ipTM: interface predicted TM score (>0.55 = good, >0.7 = excellent)\n",
    "    - pTM: overall predicted TM score\n",
    "    - pLDDT: per-residue confidence\n",
    "    \"\"\"\n",
    "    import os\n",
    "    import glob\n",
    "    \n",
    "    # Find scores JSON file\n",
    "    score_files = glob.glob(os.path.join(result_dir, '*scores*.json'))\n",
    "    if not score_files:\n",
    "        return {}\n",
    "    \n",
    "    all_metrics = []\n",
    "    for sf in score_files:\n",
    "        with open(sf) as f:\n",
    "            scores = json.load(f)\n",
    "        \n",
    "        iptm = scores.get('iptm', 0)\n",
    "        ptm = scores.get('ptm', 0)\n",
    "        plddt = scores.get('plddt', [])\n",
    "        \n",
    "        mean_plddt = np.mean(plddt) if plddt else 0\n",
    "        \n",
    "        all_metrics.append({\n",
    "            'iptm': iptm,\n",
    "            'ptm': ptm,\n",
    "            'mean_plddt': mean_plddt,\n",
    "            'file': sf\n",
    "        })\n",
    "    \n",
    "    # Return best model\n",
    "    if all_metrics:\n",
    "        best = max(all_metrics, key=lambda x: x['iptm'])\n",
    "        return best\n",
    "    return {}\n",
    "\n",
    "\n",
    "# ─── ALTERNATIVE: LOCAL COLABFOLD (if installed on Kaggle GPU) ─────────────────\n",
    "def run_local_colabfold(binder_seq: str, target_seq: str, name: str, output_dir: str = '.') -> Dict:\n",
    "    \"\"\"\n",
    "    Run ColabFold locally if installed.\n",
    "    Requires: colabfold installed, internet for MSA\n",
    "    \"\"\"\n",
    "    import os\n",
    "    import subprocess\n",
    "    \n",
    "    # Create FASTA input\n",
    "    fasta_content = f'>binder\\n{binder_seq}\\n>egfr_d3\\n{target_seq}\\n'\n",
    "    fasta_path = f'{name}_input.fasta'\n",
    "    \n",
    "    with open(fasta_path, 'w') as f:\n",
    "        f.write(fasta_content)\n",
    "    \n",
    "    result_dir = os.path.join(output_dir, name)\n",
    "    os.makedirs(result_dir, exist_ok=True)\n",
    "    \n",
    "    cmd = [\n",
    "        'colabfold_batch',\n",
    "        fasta_path,\n",
    "        result_dir,\n",
    "        '--model-type', 'alphafold2_multimer_v3',\n",
    "        '--num-recycle', '3',\n",
    "        '--num-seeds', '1',\n",
    "        '--rank', 'iptm',\n",
    "    ]\n",
    "    \n",
    "    try:\n",
    "        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)\n",
    "        metrics = parse_alphafold_metrics(result_dir)\n",
    "        return metrics\n",
    "    except Exception as e:\n",
    "        print(f'  ❌ ColabFold failed: {e}')\n",
    "        return {}\n",
    "\n",
    "print('✅ ColabFold functions defined')"
   ]
