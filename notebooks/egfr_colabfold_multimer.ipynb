    "# ─── COMPOSITE SCORING & FINAL RANKING ───────────────────────────────────────\n",
    "# Combines all metrics into a final competition ranking\n",
    "\n",
    "def compute_composite_score(candidate: Dict) -> float:\n",
    "    \"\"\"\n",
    "    Composite score for competition submission ranking.\n",
    "    \n",
    "    Weights:\n",
    "    - ipTM (binding confidence):      35%\n",
    "    - pH switch score (conditionality): 35%\n",
    "    - ESMFold pLDDT (foldability):    20%\n",
    "    - pTM (complex quality):          10%\n",
    "    \"\"\"\n",
    "    iptm = candidate.get('iptm', 0.4)\n",
    "    ph_score_norm = min(candidate.get('ph_score', 0) / 12.0, 1.0)  # normalize to 0-1\n",
    "    plddt_norm = min(candidate.get('plddt_overall', 0) / 100.0, 1.0)\n",
    "    ptm = candidate.get('ptm', 0.5)\n",
    "    \n",
    "    composite = (\n",
    "        0.35 * iptm +\n",
    "        0.35 * ph_score_norm +\n",
    "        0.20 * plddt_norm +\n",
    "        0.10 * ptm\n",
    "    )\n",
    "    return round(composite, 4)\n",
    "\n",
    "\n",
    "# Compute composite scores\n",
    "for r in cf_results:\n",
    "    r['composite_score'] = compute_composite_score(r)\n",
    "\n",
    "# Sort by composite score\n",
    "cf_results_ranked = sorted(cf_results, key=lambda x: -x['composite_score'])\n",
    "\n",
    "print('=== FINAL RANKED DESIGNS (Competition Submission Order) ===')\n",
    "print(f\"{'Rank':<5} {'Name':<22} {'ipTM':>6} {'pH Score':>9} {'pLDDT':>6} {'Composite':>10} {'Submit?':>8}\")\n",
    "print('-' * 75)\n",
    "\n",
    "for rank, r in enumerate(cf_results_ranked, 1):\n",
    "    submit = '✅ YES' if rank <= 15 else '❌ NO'\n",
    "    print(f\"{rank:<5} {r['name']:<22} {r['iptm']:>6.3f} {r['ph_score']:>9.2f} \"\n",
    "          f\"{r.get('plddt_overall', 0):>6.1f} {r['composite_score']:>10.4f} {submit:>8}\")\n",
    "\n",
    "# Select top 15 for submission\n",
    "final_submission = cf_results_ranked[:15]\n",
    "print(f'\\n🎯 Top {len(final_submission)} designs selected for submission')"
